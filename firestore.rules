rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions & Authorization
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == 'thabisomaqhawengwenya@gmail.com';
    }

    function isValidMessage() {
      return request.resource.data.name is string &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.name.size() <= 100 &&
             request.resource.data.email is string &&
             request.resource.data.email.size() > 3 &&
             request.resource.data.email.size() <= 150 &&
             request.resource.data.message is string &&
             request.resource.data.message.size() > 0 &&
             request.resource.data.message.size() <= 5000;
    }

    // ===============================================================
    // Public Portfolio Collections (Read: Anyone, Write: Admin Only)
    // ===============================================================
    match /projects/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /certificates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /journey/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /skills/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /heroContent/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ===============================================================
    // Messages Collection (Create: Valid Public Submissions, Manage: Admin Only)
    // ===============================================================
    match /messages/{document=**} {
      allow create: if isValidMessage();
      allow read, update, delete: if isAdmin();
    }
  }
}
